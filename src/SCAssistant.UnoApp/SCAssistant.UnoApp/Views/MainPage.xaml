<Page
    x:Class="SCAssistant.UnoApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SCAssistant.UnoApp.Views"
    xmlns:converters="using:SCAssistant.UnoApp.Converters"
    mc:Ignorable="d"
    d:DesignWidth="1024" d:DesignHeight="768">

    <!-- 资源 -->
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Padding="4,2"
                    Background="{ThemeResource SystemAltMediumLowColor}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="首页" Command="{Binding NavigateHomeCommand}" Width="60" />
                    <Button Content="SCKey" Command="{Binding NavigateSCKeyCommand}" Width="60" />
                    <Button Content="SCWZ" Command="{Binding NavigateSCWZCommand}" Width="60" />
                    <Rectangle Width="8" />
                    <!-- Address bar -->
                    <TextBox x:Name="AddressBar"
                             Text="{Binding CurrentUrl, Mode=OneWay}"
                             PlaceholderText="输入网址后按回车或点跳转"
                             Width="300"
                             VerticalAlignment="Center"
                             KeyDown="AddressBar_KeyDown" />
                    <Button x:Name="GoButton"
                            Content="跳转"
                            Width="50"
                            Click="GoButton_Click" />
                    <Rectangle Width="8" />
                    <Button Content="设置" Command="{Binding OpenSettingsCommand}" Width="60" />
                    <!-- Loading indicator -->
                    <TextBlock Text="加载中..." VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Browser host -->
            <Grid Grid.Row="1" x:Name="BrowserHost"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- 设置面板覆盖层 -->
        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <Grid Background="#80000000" />
            <!-- 设置面板靠右显示 -->
            <views:SettingsPanel x:Name="SettingsPanelControl"
                                  DataContext="{Binding Settings}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Width="380" />
        </Grid>
    </Grid>
</Page>
