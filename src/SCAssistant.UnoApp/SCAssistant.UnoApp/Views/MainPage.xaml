<Page
    x:Class="SCAssistant.UnoApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SCAssistant.UnoApp.Views"
    xmlns:converters="using:SCAssistant.UnoApp.Converters"
    xmlns:utu="using:Uno.Toolkit.UI"
    mc:Ignorable="d"
    d:DesignWidth="1024" d:DesignHeight="768">

    <!-- 资源 -->
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- 底部导航按钮样式：等宽矩形按钮，当前所在站点由代码高亮为蓝色 -->
        <Style x:Key="BottomBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource SystemBaseMediumColor}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WideToolbar.Visibility" Value="Collapsed" />
                        <Setter Target="NarrowToolbar.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WideToolbar.Visibility" Value="Visible" />
                        <Setter Target="NarrowToolbar.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main content -->
        <Grid x:Name="RootGrid" utu:SafeArea.Insets="VisibleBounds">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========== 宽屏工具栏 (桌面端，单行) ========== -->
            <Border Grid.Row="0" x:Name="WideToolbar" Padding="4,2"
                    Background="{ThemeResource SystemAltMediumLowColor}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Address bar -->
                    <TextBox Grid.Column="0" x:Name="AddressBar"
                             Text="{Binding CurrentUrl, Mode=OneWay}"
                             PlaceholderText="输入网址后按回车或点跳转"
                             Width="300"
                             VerticalAlignment="Center"
                             KeyDown="AddressBar_KeyDown" />
                    <Button Grid.Column="1" x:Name="GoButton"
                            Content="跳转"
                            Width="50"
                            Click="GoButton_Click" />
                    <Button Grid.Column="2" Content="后退"
                            Command="{Binding NavigateBackCommand}"
                            Width="50" />
                    <Button Grid.Column="3" Content="前进"
                            Command="{Binding NavigateForwardCommand}"
                            Width="50" />
                    <!-- Spacer -->
                    <Border Grid.Column="4" />
                    <!-- Loading indicator -->
                    <TextBlock Grid.Column="5" Text="加载中..." VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Grid.Column="6" Content="设置" Command="{Binding OpenSettingsCommand}" Width="60" />
                </Grid>
            </Border>

            <!-- ========== 窄屏工具栏 (手机端，双行) ========== -->
            <Border Grid.Row="0" x:Name="NarrowToolbar" Padding="4,2"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemAltMediumLowColor}">
                <StackPanel Spacing="3">
                    <!-- 第1行：加载指示 + 设置 -->
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="加载中..." VerticalAlignment="Center" FontSize="11"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- 弹性空白：推动设置按钮到最右 -->
                        <Border Grid.Column="1" />
                        <Button Grid.Column="2" Content="设置" FontSize="12"
                                Command="{Binding OpenSettingsCommand}" Width="55" Padding="4,4" />
                    </Grid>
                    <!-- 第2行：地址栏 + 跳转 + 后退 + 前进 -->
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NarrowAddressBar"
                                 Text="{Binding CurrentUrl, Mode=OneWay}"
                                 PlaceholderText="输入网址后跳转"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 KeyDown="NarrowAddressBar_KeyDown" />
                        <Button Grid.Column="1" x:Name="NarrowGoButton"
                                Content="跳转" FontSize="12"
                                Width="42" Padding="2,4"
                                Click="NarrowGoButton_Click" />
                        <Button Grid.Column="2" Content="后退" FontSize="12"
                                Command="{Binding NavigateBackCommand}"
                                Width="42" Padding="2,4" />
                        <Button Grid.Column="3" Content="前进" FontSize="12"
                                Command="{Binding NavigateForwardCommand}"
                                Width="42" Padding="2,4" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Browser host -->
            <Grid Grid.Row="1" x:Name="BrowserHost"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ========== 底栏 (SC 快捷导航，3 个等宽矩形按钮分割底部空间) ========== -->
            <Border Grid.Row="2" Background="{ThemeResource SystemAltMediumLowColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BottomTabHome" Content="SC中文社区"
                            Command="{Binding NavigateHomeCommand}"
                            Style="{StaticResource BottomBarButtonStyle}" />
                    <Button Grid.Column="1" x:Name="BottomTabSCKey" Content="SC联机号"
                            Command="{Binding NavigateSCKeyCommand}"
                            Style="{StaticResource BottomBarButtonStyle}" />
                    <Button Grid.Column="2" x:Name="BottomTabSCWZ" Content="SC导航网"
                            Command="{Binding NavigateSCWZCommand}"
                            Style="{StaticResource BottomBarButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 设置面板覆盖层 -->
        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <Grid Background="#80000000" />
            <!-- 设置面板靠右显示 -->
            <views:SettingsPanel x:Name="SettingsPanelControl"
                                  DataContext="{Binding Settings}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Width="380" />
        </Grid>
    </Grid>
</Page>
