<Page
    x:Class="SCAssistant.UnoApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SCAssistant.UnoApp.Views"
    xmlns:converters="using:SCAssistant.UnoApp.Converters"
    mc:Ignorable="d"
    d:DesignWidth="1024" d:DesignHeight="768">

    <Grid>
        <!-- Main content -->
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Padding="4,2"
                    Background="{ThemeResource SystemAltMediumLowColor}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="首页" Command="{Binding NavigateHomeCommand}" Width="60" />
                    <Button Content="SCKey" Command="{Binding NavigateSCKeyCommand}" Width="60" />
                    <Button Content="SCWZ" Command="{Binding NavigateSCWZCommand}" Width="60" />
                    <StackPanel Width="8" />
                    <!-- Address bar -->
                    <TextBox x:Name="AddressBar"
                             Text="{Binding CurrentUrl, Mode=OneWay}"
                             PlaceholderText="输入网址后按回车或点跳转"
                             Width="300"
                             VerticalAlignment="Center"
                             KeyDown="AddressBar_KeyDown" />
                    <Button x:Name="GoButton"
                            Content="跳转"
                            Width="50"
                            Click="GoButton_Click" />
                    <StackPanel Width="8" />
                    <Button Content="下载列表" Command="{Binding OpenDownloadListCommand}" Width="80" />
                    <!-- Loading indicator -->
                    <TextBlock Text="加载中..." VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding IsBrowserLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Browser host — 直接 Grid 容器，消除 ContentControl 中间层导致的布局丢失 -->
            <Grid Grid.Row="1" x:Name="BrowserHost" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- Download list overlay panel -->
        <Grid Visibility="{Binding IsDownloadListVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Canvas.ZIndex="100">
            <Grid Background="#80000000">
                <views:DownloadListPanel x:Name="DownloadListPanelControl"
                                          DataContext="{Binding DownloadList}"
                                          MaxWidth="480"
                                          MaxHeight="500"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
