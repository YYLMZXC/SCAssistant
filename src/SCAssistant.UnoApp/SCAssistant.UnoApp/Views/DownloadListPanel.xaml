<UserControl
    x:Class="SCAssistant.UnoApp.Views.DownloadListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SCAssistant.UnoApp.Converters"
    mc:Ignorable="d"
    d:DesignWidth="360" d:DesignHeight="500">

    <UserControl.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:DownloadStateToTextConverter x:Key="StateToTextConverter" />
        <converters:ProgressToPercentTextConverter x:Key="ProgressToPercentTextConverter" />
    </UserControl.Resources>

    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SystemBaseLowColor}"
            BorderThickness="1" CornerRadius="4" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="下载文件列表" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,8" />

            <!-- List -->
            <ListView Grid.Row="1"
                      x:Name="RootList"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4" Margin="0,2">
                            <StackPanel Spacing="2">
                                <!-- 文件名 + 文件大小 -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileSizeDisplay}"
                                               FontSize="11" Foreground="Gray"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>

                                <!-- 进度条 -->
                                <ProgressBar Value="{Binding Progress}" Maximum="100"
                                             Height="4"
                                             Visibility="Visible"
                                             Margin="0,2" />

                                <!-- 状态 + 百分比 -->
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding State, Converter={StaticResource StateToTextConverter}}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding Progress, Converter={StaticResource ProgressToPercentTextConverter}}" />
                                </TextBlock>

                                <TextBlock Text="{Binding Url}" FontSize="11"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LocalPath}" FontSize="11"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}"
                        IsEnabled="{Binding ElementName=RootList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" />
                <Button Content="删除记录" Command="{Binding DeleteRecordCommand}"
                        IsEnabled="{Binding ElementName=RootList, Path=SelectedItem, Converter={StaticResource IsNotNullConverter}}" />
                <Button Content="删除所有记录" Command="{Binding DeleteAllRecordsCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
