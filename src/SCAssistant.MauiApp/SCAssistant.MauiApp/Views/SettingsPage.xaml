<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SCAssistant.Maui.ViewModels"
             x:Class="SCAssistant.Maui.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="设置">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- 常规设置 -->
            <Label Text="常规" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Frame Padding="12" CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="12">

                    <!-- 暗黑模式 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="暗黑模式" FontSize="15" />
                            <Label Text="使用深色主题" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding DarkMode, Mode=TwoWay}"
                                OnColor="{StaticResource Primary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                    <!-- 缩放级别 -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="默认缩放" FontSize="15" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="50%" VerticalOptions="Center" FontSize="12" TextColor="Gray" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0"
                                    Value="{Binding ZoomLevel, Mode=TwoWay}" />
                            <Label Grid.Column="2" Text="200%" VerticalOptions="Center" FontSize="12" TextColor="Gray" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- 下载设置 -->
            <Label Text="下载" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Frame Padding="12" CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="12">

                    <!-- 最大下载线程数 -->
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="15">
                            <Label.Text>
                                <Binding Path="MaxDownloadThreads" StringFormat="最大下载线程数: {0}" />
                            </Label.Text>
                        </Label>
                        <Stepper Minimum="1" Maximum="10" Increment="1"
                                 Value="{Binding MaxDownloadThreads, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" />

                    <!-- 下载目录 -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="下载目录" FontSize="15" />
                            <Label Text="{Binding DownloadDirectory}" FontSize="12" TextColor="Gray"
                                   LineBreakMode="MiddleTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="浏览..."
                                FontSize="13" Padding="12,6"
                                BackgroundColor="{StaticResource Gray200}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                CornerRadius="6"
                                x:Name="BtnBrowse" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- 关于 -->
            <Label Text="关于" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Frame Padding="12" CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="应用版本" FontSize="15" />
                    <Label Grid.Column="1" Text="1.0.0" FontSize="15" TextColor="Gray" />
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
