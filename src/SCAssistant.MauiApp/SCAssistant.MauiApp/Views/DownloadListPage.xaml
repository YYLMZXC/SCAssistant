<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SCAssistant.Maui.ViewModels"
             xmlns:models="clr-namespace:SCAssistant.Maui.Models"
             xmlns:conv="clr-namespace:SCAssistant.Maui.Converters"
             x:Class="SCAssistant.Maui.Views.DownloadListPage"
             x:DataType="vm:DownloadListViewModel"
             Title="下载管理">

    <ContentPage.Resources>
        <conv:ProgressToPercentConverter x:Key="ProgressToPercent" />
        <conv:BytesToSizeConverter x:Key="BytesToSize" />
        <conv:DownloadStatusToColorConverter x:Key="StatusToColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="0">

        <!-- 下载列表 -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Downloads}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="暂无下载" FontSize="18" TextColor="Gray"
                           HorizontalOptions="Center" />
                    <Label Text="在浏览器中点击下载链接开始下载" FontSize="14" TextColor="LightGray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadRecord">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="删除" BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DownloadListViewModel}}, Path=DeleteDownloadCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="12,8" Margin="4,2" StrokeShape="RoundRectangle 6"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="8">

                                <!-- 文件名 -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding FileName}"
                                       FontSize="14" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <!-- 状态标签 -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Status}"
                                       TextColor="{Binding Status, Converter={StaticResource StatusToColor}}"
                                       FontSize="12" VerticalOptions="Center" />

                                <!-- 进度条 -->
                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             Progress="{Binding Progress}"
                                             ProgressColor="{Binding Status, Converter={StaticResource StatusToColor}}" />

                                <!-- 大小信息 -->
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="12">
                                    <Label FontSize="11" TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="DownloadedBytes" Converter="{StaticResource BytesToSize}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Progress, Converter={StaticResource ProgressToPercent}}"
                                           FontSize="11" TextColor="Gray" />
                                </HorizontalStackLayout>

                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CreatedAt, StringFormat='{0:MM-dd HH:mm}'}"
                                       FontSize="11" TextColor="Gray" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 底部操作栏 -->
        <Button Grid.Row="1"
                Text="清空全部"
                Command="{Binding ClearAllCommand}"
                BackgroundColor="{StaticResource Gray200}"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                Margin="8" Padding="12,8"
                CornerRadius="8" />
    </Grid>

</ContentPage>
