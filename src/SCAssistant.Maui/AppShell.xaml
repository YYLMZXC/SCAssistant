<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SCAssistant.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SCAssistant.Maui"
    Title="生存战争助手">

    <TabBar>
        <ShellContent
            Title="浏览器"
            Icon="home.svg"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        
        <ShellContent
            Title="下载"
            Icon="download.svg"
            ContentTemplate="{DataTemplate local:DownloadListPage}"
            Route="DownloadListPage" />
    </TabBar>

</Shell>
