<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCAssistant.AvaloniaApp.ViewModels"
             xmlns:views="clr-namespace:SCAssistant.AvaloniaApp.Views"
             xmlns:conv="clr-namespace:SCAssistant.AvaloniaApp.Converters"
             x:Class="SCAssistant.AvaloniaApp.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PageBg" Color="#FFFFFF" />
        <conv:TabIndexToBrushConverter x:Key="TabIndexToBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvertBoolVis" />
        <conv:IntInRangeConverter x:Key="IntInRange" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 底部标签按钮 -->
        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,6,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 设置页关闭按钮 -->
        <Style Selector="Button.CloseSetBtn">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- 导航按钮：后退 / 前进 -->
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Background" Value="#E8E8E8" />
        </Style>
        <Style Selector="Button.NavBtn:disabled">
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- 跳转按钮 -->
        <Style Selector="Button.GoBtn">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.GoBtn:pointerover">
            <Setter Property="Background" Value="#106EBE" />
        </Style>

        <!-- 设置按钮 -->
        <Style Selector="Button.SettingsBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SettingsBtn:pointerover">
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Background" Value="#E8E8E8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource PageBg}">

        <!-- ===== 顶部地址栏工具栏（所有标签页始终可见） ===== -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="8,6"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="32">
                <!-- 后退按钮 -->
                <Button Grid.Column="0" Classes="NavBtn"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Content="◀" />
                <!-- 前进按钮 -->
                <Button Grid.Column="1" Classes="NavBtn"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Content="▶" />
                <!-- 地址栏 -->
                <TextBox Grid.Column="2"
                         x:Name="AddressTextBox"
                         Text="{Binding CurrentUrl, Mode=OneWay}"
                         PlaceholderText="输入网址或搜索..."
                         Background="#FFFFFF"
                         Foreground="#222222"
                         CaretBrush="#0078D4"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         CornerRadius="6"
                         FontSize="14"
                         Padding="12,0"
                         Margin="8,0"
                         VerticalContentAlignment="Center"
                         KeyDown="AddressTextBox_KeyDown" />
                <!-- 跳转按钮 -->
                <Button Grid.Column="3" Classes="GoBtn"
                        Command="{Binding NavigateToUrlCommand}"
                        CommandParameter="{Binding Text, ElementName=AddressTextBox}"
                        Content="→" />
                <!-- 设置按钮 -->
                <Button Grid.Column="4" Classes="SettingsBtn"
                        Command="{Binding ToggleSettingsCommand}"
                        Content="⚙" />
            </Grid>
        </Border>

        <!-- ===== 内容区：浏览器 + 主页，设置面板叠加在上方 ===== -->
        <Grid Grid.Row="1">
            <!-- 浏览器 (Tab 0-2) -->
            <views:BrowserView x:Name="BrowserArea"
                               IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntInRange}, ConverterParameter=0-2}" />

            <!-- 主页/工具 (Tab 3) -->
            <views:HomeView x:Name="HomeArea"
                            IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=3}" />

            <!-- 设置面板叠加层（从右侧滑入） -->
            <Border IsVisible="{Binding IsSettingsOpen}"
                    Background="#80000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid ColumnDefinitions="*,400">
                    <!-- 左侧空白区点击关闭 -->
                    <Button Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleSettingsCommand}" />
                    <!-- 设置面板 -->
                    <Border Grid.Column="1"
                            Background="{StaticResource PageBg}"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 设置面板标题栏 -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BarBg}"
                                    Padding="14,10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="设置"
                                               Foreground="#333333"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="CloseSetBtn"
                                            Command="{Binding ToggleSettingsCommand}"
                                            Content="✕ 关闭" />
                                </Grid>
                            </Border>
                            <!-- 设置内容 -->
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled">
                                <views:SettingsView x:Name="SettingsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部标签栏（4 个标签，已移除"设置"） ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BarBg}"
                Padding="0,2,0,3"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*" Height="36">
                <Button Grid.Column="0" Classes="TabBtn"
                        Command="{Binding GoToTab0Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=0}"
                        Content="SC中文社区" />
                <Button Grid.Column="1" Classes="TabBtn"
                        Command="{Binding GoToTab1Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=1}"
                        Content="SC联机号" />
                <Button Grid.Column="2" Classes="TabBtn"
                        Command="{Binding GoToTab2Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=2}"
                        Content="SC导航网" />
                <Button Grid.Column="3" Classes="TabBtn"
                        Command="{Binding GoToTab3Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=3}"
                        Content="工具" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
