<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCAssistant.AvaloniaApp.ViewModels"
             xmlns:conv="using:SCAssistant.AvaloniaApp.Converters"
             x:Class="SCAssistant.AvaloniaApp.Views.MainView">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusToTextConverter x:Key="StatusToText" />
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Navigation Bar -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Background="#2D2D30"
              Height="44">

            <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding CanGoBack}" 
                    Background="Transparent" Foreground="White"
                    Width="36" Height="36" FontSize="16">◀</Button>

            <Button Grid.Column="1" Command="{Binding GoForwardCommand}"
                    IsEnabled="{Binding CanGoForward}"
                    Background="Transparent" Foreground="White"
                    Width="36" Height="36" FontSize="16">▶</Button>

            <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                    Background="Transparent" Foreground="White"
                    Width="36" Height="36" FontSize="16">↻</Button>

            <Border Grid.Column="3" Background="#3E3E42" 
                    CornerRadius="16" Padding="8,0" Margin="4,0"
                    Height="32" VerticalAlignment="Center">
                <TextBox Text="{Binding AddressBarUrl}" 
                         Background="Transparent" Foreground="White"
                         BorderThickness="0" FontSize="13"
                         VerticalContentAlignment="Center" />
            </Border>

            <Button Grid.Column="4" Command="{Binding ToggleDownloadPanelCommand}"
                    Background="Transparent" Foreground="White"
                    Width="36" Height="36" FontSize="16">⬇</Button>

            <Button Grid.Column="5" Command="{Binding ToggleSettingsCommand}"
                    Background="Transparent" Foreground="White"
                    Width="36" Height="36" FontSize="16">⚙</Button>
        </Grid>

        <!-- Loading Bar -->
        <Border Grid.Row="1" Height="2" 
                Background="#2196F3"
                IsVisible="{Binding IsLoading}" />

        <!-- Content -->
        <Border Grid.Row="2" Background="#1E1E1E">
            <TextBlock Text="{Binding PageTitle}"
                       Foreground="White" FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20" />
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Height="3" />
    </Grid>
</UserControl>
