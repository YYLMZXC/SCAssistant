<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCAssistant.AvaloniaApp.ViewModels"
             x:Class="SCAssistant.AvaloniaApp.Views.HomeView">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto"
          Background="#FFFFFF">

        <!-- Welcome Content -->
        <StackPanel Grid.Row="0" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="20">

            <TextBlock Text="🛠"
                       FontSize="64"
                       HorizontalAlignment="Center" />

            <TextBlock Text="SCAssistant"
                       FontSize="32" FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Survivalcraft 工具助手"
                       FontSize="16"
                       Foreground="#666666"
                       HorizontalAlignment="Center" />

            <!-- Search Bar -->
            <Border Background="#F0F0F0"
                    CornerRadius="24" Padding="16,10"
                    Width="500" MaxWidth="500">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="🔍" FontSize="18" 
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText}"
                             Background="Transparent" Foreground="#333333"
                             BorderThickness="0" FontSize="16"
                             PlaceholderText="输入网址或搜索..."
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" 
                                        Command="{Binding SearchCommand}"
                                        CommandParameter="{Binding SearchText}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Quick Links -->
            <WrapPanel HorizontalAlignment="Center" 
                       Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="SC 中文社区" 
                        Command="{Binding NavigateQuickLinkCommand}"
                        CommandParameter="https://www.scbbs.top/"
                        Background="#F0F0F0" Foreground="#333333"
                        CornerRadius="8" Padding="20,10" Margin="6" />

                <Button Content="SC 联机号" 
                        Command="{Binding NavigateQuickLinkCommand}"
                        CommandParameter="https://www.sckey.net/"
                        Background="#F0F0F0" Foreground="#333333"
                        CornerRadius="8" Padding="20,10" Margin="6" />

                <Button Content="SC 导航网" 
                        Command="{Binding NavigateQuickLinkCommand}"
                        CommandParameter="https://scwz.top/"
                        Background="#F0F0F0" Foreground="#333333"
                        CornerRadius="8" Padding="20,10" Margin="6" />
            </WrapPanel>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="1" 
                   Text="SCAssistant v1.0 - Survivalcraft Tool"
                   Foreground="#999999" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,0,0,20" />
    </Grid>
</UserControl>
