<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SCAssistant.AvaloniaApp.ViewModels"
        xmlns:views="clr-namespace:SCAssistant.AvaloniaApp.Views"
        xmlns:conv="clr-namespace:SCAssistant.AvaloniaApp.Converters"
        x:Class="SCAssistant.AvaloniaApp.Views.MainWindow"
        Title="SCAssistant"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PageBg" Color="#FFFFFF" />
        <conv:TabIndexToBrushConverter x:Key="TabIndexToBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvertBoolVis" />
        <conv:IntInRangeConverter x:Key="IntInRange" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,6,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.CloseSetBtn">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Background="{StaticResource PageBg}">

        <!-- ===== 内容区：浏览器 + 主页 + 设置面板 ===== -->
        <Grid Grid.Row="0">
            <!-- 浏览器 (Tab 0-2) -->
            <views:BrowserView x:Name="BrowserArea"
                               IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntInRange}, ConverterParameter=0-2}" />

            <!-- 主页/工具 (Tab 3) -->
            <views:HomeView x:Name="HomeArea"
                            IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=3}" />

            <!-- 设置面板 (Tab 4) -->
            <Grid IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=4}"
                  RowDefinitions="Auto,*"
                  Background="{StaticResource PageBg}">
                <Border Grid.Row="0"
                        Background="{StaticResource BarBg}"
                        Padding="14,10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" MaxWidth="800"
                          HorizontalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="设置"
                                   Foreground="#333333"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="CloseSetBtn"
                                Command="{Binding CloseSettingsCommand}"
                                Content="← 返回" />
                    </Grid>
                </Border>
                <!-- 设置内容居中 -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <views:SettingsView x:Name="SettingsPanel"
                                        MaxWidth="800"
                                        HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== 底部标签栏 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource BarBg}"
                Padding="0,2,0,3"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*,*" Height="36"
                  MaxWidth="700" HorizontalAlignment="Center">

                <Button Grid.Column="0" Classes="TabBtn"
                        Command="{Binding GoToTab0Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=0}"
                        Content="SC中文社区" />

                <Button Grid.Column="1" Classes="TabBtn"
                        Command="{Binding GoToTab1Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=1}"
                        Content="SC联机号" />

                <Button Grid.Column="2" Classes="TabBtn"
                        Command="{Binding GoToTab2Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=2}"
                        Content="SC导航网" />

                <Button Grid.Column="3" Classes="TabBtn"
                        Command="{Binding GoToTab3Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=3}"
                        Content="工具" />

                <Button Grid.Column="4" Classes="TabBtn"
                        Command="{Binding GoToTab4Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=4}"
                        Content="设置" />
            </Grid>
        </Border>
    </Grid>
</Window>
