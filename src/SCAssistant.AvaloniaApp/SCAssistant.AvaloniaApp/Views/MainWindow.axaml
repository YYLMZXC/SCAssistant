<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SCAssistant.AvaloniaApp.ViewModels"
        xmlns:views="clr-namespace:SCAssistant.AvaloniaApp.Views"
        xmlns:conv="clr-namespace:SCAssistant.AvaloniaApp.Converters"
        x:Class="SCAssistant.AvaloniaApp.Views.MainWindow"
        Title="SCAssistant"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#1E1E20" />
        <SolidColorBrush x:Key="PageBg" Color="#141416" />
        <conv:TabIndexToBrushConverter x:Key="TabIndexToBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvertBoolVis" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAABAF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style Selector="Button.NavBtn:disabled">
            <Setter Property="Foreground" Value="#555555" />
        </Style>

        <Style Selector="Button.TabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,10,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.CloseSetBtn">
            <Setter Property="Background" Value="#2A2A2E" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource PageBg}">

        <!-- ===== 顶部地址栏 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BarBg}"
                Padding="10,10"
                BorderBrush="#2A2A2E"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="38">
                <Button Grid.Column="0" Classes="NavBtn"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Content="◀" />
                <Button Grid.Column="1" Classes="NavBtn"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Content="▶" />
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentUrl, Mode=TwoWay}"
                         PlaceholderText="输入网址..."
                         Background="#252528"
                         Foreground="#E0E0E0"
                         CaretBrush="#80D4FF"
                         BorderBrush="#3A3A3E"
                         BorderThickness="1"
                         CornerRadius="4"
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Name="AddressBarTextBox">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" 
                                            Command="{Binding NavigateToUrlCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                <Button Grid.Column="3" Classes="NavBtn"
                        Command="{Binding NavigateToUrlCommand}"
                        Foreground="#80D4FF"
                        FontWeight="Bold" FontSize="16"
                        Content="→" />
            </Grid>
        </Border>

        <!-- ===== 内容区：浏览器 + 设置面板 ===== -->
        <Grid Grid.Row="1">
            <!-- 浏览器 -->
            <views:BrowserView x:Name="BrowserArea"
                               IsVisible="{Binding IsSettingsOpen, Converter={StaticResource InvertBoolVis}}" />

            <!-- 设置面板叠加 -->
            <Grid IsVisible="{Binding IsSettingsOpen, FallbackValue=False}"
                  RowDefinitions="Auto,*"
                  Background="{StaticResource PageBg}">
                <Border Grid.Row="0"
                        Background="{StaticResource BarBg}"
                        Padding="16,12"
                        BorderBrush="#2A2A2E"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" MaxWidth="800"
                          HorizontalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="设置"
                                   Foreground="#E0E0E0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="CloseSetBtn"
                                Command="{Binding CloseSettingsCommand}"
                                Content="← 返回" />
                    </Grid>
                </Border>
                <!-- 设置内容居中 -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <views:SettingsView x:Name="SettingsPanel"
                                        MaxWidth="800"
                                        HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== 底部标签栏 ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BarBg}"
                Padding="0,4,0,6"
                BorderBrush="#2A2A2E"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*,*" Height="44"
                  MaxWidth="700" HorizontalAlignment="Center">

                <Button Grid.Column="0" Classes="TabBtn"
                        Command="{Binding GoToTab0Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=0}"
                        Content="SC中文社区" />

                <Button Grid.Column="1" Classes="TabBtn"
                        Command="{Binding GoToTab1Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=1}"
                        Content="SC联机号" />

                <Button Grid.Column="2" Classes="TabBtn"
                        Command="{Binding GoToTab2Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=2}"
                        Content="SC导航网" />

                <Button Grid.Column="3" Classes="TabBtn"
                        Command="{Binding GoToTab3Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=3}"
                        Content="工具" />

                <Button Grid.Column="4" Classes="TabBtn"
                        Command="{Binding GoToTab4Command}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrush}, ConverterParameter=4}"
                        Content="设置" />
            </Grid>
        </Border>
    </Grid>
</Window>
