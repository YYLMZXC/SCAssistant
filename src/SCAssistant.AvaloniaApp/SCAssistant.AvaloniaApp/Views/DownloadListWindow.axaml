<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SCAssistant.AvaloniaApp.ViewModels"
        xmlns:models="using:SCAssistant.AvaloniaApp.Models"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="SCAssistant.AvaloniaApp.Views.DownloadListWindow"
        x:DataType="vm:DownloadListViewModel"
        Title="下载文件列表"
        Width="700" Height="500">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ListBox Grid.Row="0"
                 x:Name="RootList"
                 ItemsSource="{Binding Records}"
                 SelectedItem="{Binding SelectedRecord}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadRecord">
                    <Grid ColumnDefinitions="180,*,150" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Url}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding LocalPath}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}"
                    IsEnabled="{Binding #RootList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="删除记录" Command="{Binding DeleteRecordCommand}"
                    IsEnabled="{Binding #RootList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </Grid>
</Window>
