<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SCAssistant.AvaloniaApp.ViewModels"
             xmlns:models="using:SCAssistant.AvaloniaApp.Models"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="500"
             x:Class="SCAssistant.AvaloniaApp.Views.DownloadListWindow"
             x:DataType="vm:DownloadListViewModel">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" CornerRadius="4" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="下载文件列表" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- List -->
            <ListBox Grid.Row="1"
                     x:Name="RootList"
                     ItemsSource="{Binding Records}"
                     SelectedItem="{Binding SelectedRecord}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadRecord">
                        <Border Padding="4" Margin="0,2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Url}" FontSize="11"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LocalPath}" FontSize="11"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}"
                        IsEnabled="{Binding #RootList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="删除记录" Command="{Binding DeleteRecordCommand}"
                        IsEnabled="{Binding #RootList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
