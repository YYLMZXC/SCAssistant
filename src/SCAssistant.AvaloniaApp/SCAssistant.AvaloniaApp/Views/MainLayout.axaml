<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCAssistant.AvaloniaApp.ViewModels"
             xmlns:views="clr-namespace:SCAssistant.AvaloniaApp.Views"
             x:Class="SCAssistant.AvaloniaApp.Views.MainLayout"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PageBg" Color="#FFFFFF" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 底部自适应方框标签按钮 -->
        <Style Selector="Button.TabBtn">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.TabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8E8E8" />
        </Style>

        <!-- 设置页关闭按钮 -->
        <Style Selector="Button.CloseSetBtn">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <!-- 导航按钮：后退 / 前进 -->
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#B0B0B0" />
        </Style>
        <Style Selector="Button.NavBtn:disabled">
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- 跳转按钮 -->
        <Style Selector="Button.GoBtn">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#006CBE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.GoBtn:pointerover">
            <Setter Property="Background" Value="#106EBE" />
        </Style>

        <!-- 设置按钮 -->
        <Style Selector="Button.SettingsBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SettingsBtn:pointerover">
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#B0B0B0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource PageBg}">

        <!-- ===== 顶部地址栏工具栏（所有标签页始终可见） ===== -->
        <Border Grid.Row="0"
                Background="#F0F0F0"
                Padding="12,6"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                  ColumnSpacing="6"
                  Height="38">
                <!-- 后退按钮 -->
                <Button Grid.Column="0" Classes="NavBtn"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Content="◀" />
                <!-- 前进按钮 -->
                <Button Grid.Column="1" Classes="NavBtn"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Content="▶" />
                <!-- 地址栏 -->
                <TextBox Grid.Column="2"
                         x:Name="AddressTextBox"
                         Text="{Binding CurrentUrl, Mode=TwoWay}"
                         PlaceholderText="输入网址或搜索..."
                         Background="#FFFFFF"
                         Foreground="#222222"
                         CaretBrush="#0078D4"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         CornerRadius="8"
                         FontSize="14"
                         Padding="12,0"
                         Height="32"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         KeyDown="AddressTextBox_KeyDown" />
                <!-- 跳转按钮 -->
                <Button Grid.Column="3" Classes="GoBtn"
                        Command="{Binding NavigateToUrlCommand}"
                        CommandParameter="{Binding Text, ElementName=AddressTextBox}"
                        Content="→" />
                <!-- 设置按钮 -->
                <Button Grid.Column="4" Classes="SettingsBtn"
                        Command="{Binding ToggleSettingsCommand}"
                        Content="⚙" />
            </Grid>
        </Border>

        <!-- ===== 内容区：浏览器 + 主页，设置面板叠加在上方 ===== -->
        <Grid Grid.Row="1">
            <!-- 浏览器 (Tab 0-2) -->
            <views:BrowserView x:Name="BrowserArea"
                               IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntInRangeConverter}, ConverterParameter=0-2}" />

            <!-- 主页/工具 (Tab 3) -->
            <views:HomeView x:Name="HomeArea"
                            IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" />

            <!-- 设置面板叠加层（从右侧滑入） -->
            <Border IsVisible="{Binding IsSettingsOpen}"
                    Background="#80000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid ColumnDefinitions="*,400">
                    <!-- 左侧空白区点击关闭 -->
                    <Button Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleSettingsCommand}" />
                    <!-- 设置面板 -->
                    <Border Grid.Column="1"
                            Background="{StaticResource PageBg}"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 设置面板标题栏 -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BarBg}"
                                    Padding="14,10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="设置"
                                               Foreground="#333333"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="CloseSetBtn"
                                            Command="{Binding ToggleSettingsCommand}"
                                            Content="✕ 关闭" />
                                </Grid>
                            </Border>
                            <!-- 设置内容 -->
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled">
                                <views:SettingsView x:Name="SettingsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部标签栏（自适应占满整宽） ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BarBg}"
                Padding="12,6"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="8"
                  Height="38">

                <Button Grid.Column="0" Classes="TabBtn"
                        Command="{Binding GoToTab0Command}"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=0:bg}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=0:fg}"
                        BorderBrush="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrushConverter}, ConverterParameter=0}"
                        Content="SC中文社区" />

                <Button Grid.Column="1" Classes="TabBtn"
                        Command="{Binding GoToTab1Command}"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=1:bg}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=1:fg}"
                        BorderBrush="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrushConverter}, ConverterParameter=1}"
                        Content="SC联机号" />

                <Button Grid.Column="2" Classes="TabBtn"
                        Command="{Binding GoToTab2Command}"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=2:bg}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=2:fg}"
                        BorderBrush="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrushConverter}, ConverterParameter=2}"
                        Content="SC导航网" />

                <Button Grid.Column="3" Classes="TabBtn"
                        Command="{Binding GoToTab3Command}"
                        Background="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=3:bg}"
                        Foreground="{Binding SelectedTabIndex, Converter={StaticResource TabButtonBrushConverter}, ConverterParameter=3:fg}"
                        BorderBrush="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToBrushConverter}, ConverterParameter=3}"
                        Content="工具" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
