<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCAssistant.AvaloniaApp.ViewModels"
             xmlns:conv="clr-namespace:SCAssistant.AvaloniaApp.Converters"
             x:Class="SCAssistant.AvaloniaApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="#141416">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#1E1E22" />
        <SolidColorBrush x:Key="InputBg" Color="#252528" />
        <SolidColorBrush x:Key="TextPrimary" Color="#D0D0D0" />
        <SolidColorBrush x:Key="TextMuted" Color="#888" />
        <SolidColorBrush x:Key="Accent" Color="#0078D4" />
        <SolidColorBrush x:Key="BorderColor" Color="#3A3A3E" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  Padding="16,12,16,32">
        <StackPanel Spacing="20">

            <!-- ══════ 标签页网址 ══════ -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="标签页网址"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="设置底部导航栏各标签页对应的网址"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}" />

                    <!-- SC中文社区 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SC中文社区" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding TabUrl0, Mode=TwoWay}"
                                 PlaceholderText="输入网址..."
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>

                    <!-- SC联机号 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SC联机号" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding TabUrl1, Mode=TwoWay}"
                                 PlaceholderText="输入网址..."
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>

                    <!-- SC导航网 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SC导航网" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding TabUrl2, Mode=TwoWay}"
                                 PlaceholderText="输入网址..."
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>

                    <!-- 工具 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="工具" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding TabUrl3, Mode=TwoWay}"
                                 PlaceholderText="输入网址..."
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════ 通用设置 ══════ -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="16,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="通用"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />

                    <!-- 主页 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="主页网址" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding HomePageUrl, Mode=TwoWay}"
                                 PlaceholderText="https://..."
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>

                    <!-- 下载目录 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="下载目录" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Text="{Binding DownloadDirectory, Mode=TwoWay}"
                                 PlaceholderText="默认：系统下载目录"
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,8" />
                    </StackPanel>

                    <!-- 主题 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="主题" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                  Background="{StaticResource InputBg}"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource BorderColor}"
                                  BorderThickness="1"
                                  CornerRadius="4"
                                  Padding="10,4"
                                  FontSize="13" />
                    </StackPanel>

                    <!-- 最大并行下载 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="最大并行下载数" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox HorizontalAlignment="Left" Width="80"
                                 Text="{Binding MaxConcurrentDownloads, Mode=TwoWay}"
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 FontSize="13"
                                 Padding="10,6" />
                    </StackPanel>

                    <!-- 开关项 -->
                    <CheckBox IsChecked="{Binding EnableDownloadHistory, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimary}"
                              Content="启用下载历史" />

                    <CheckBox IsChecked="{Binding EnableAdBlock, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimary}"
                              Content="启用广告拦截" />
                </StackPanel>
            </Border>

            <!-- ══════ 保存按钮 ══════ -->
            <Button Command="{Binding SaveCommand}"
                    Background="{StaticResource Accent}"
                    Foreground="White"
                    FontSize="15"
                    CornerRadius="6"
                    Padding="0,12"
                    HorizontalAlignment="Stretch"
                    Content="保存设置" />

            <!-- 底部留白 -->
            <Border Height="8" Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
