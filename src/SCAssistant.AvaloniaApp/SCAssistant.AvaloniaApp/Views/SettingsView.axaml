<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SCAssistant.AvaloniaApp.ViewModels"
             x:Class="SCAssistant.AvaloniaApp.Views.SettingsView">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid Background="#1E1E1E">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16" MaxWidth="600">
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="White" />

                <StackPanel Spacing="6">
                    <TextBlock Text="主页URL" Foreground="#CCCCCC" FontSize="13" />
                    <TextBox Text="{Binding HomePageUrl}"
                             Background="#3E3E42" Foreground="White"
                             BorderThickness="1" BorderBrush="#555"
                             CornerRadius="4" Padding="8,6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="默认搜索引擎" Foreground="#CCCCCC" FontSize="13" />
                    <TextBox Text="{Binding DefaultSearchEngine}"
                             Background="#3E3E42" Foreground="White"
                             BorderThickness="1" BorderBrush="#555"
                             CornerRadius="4" Padding="8,6" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="下载目录" Foreground="#CCCCCC" FontSize="13" />
                    <TextBox Text="{Binding DownloadDirectory}"
                             Background="#3E3E42" Foreground="White" IsReadOnly="True"
                             BorderThickness="1" BorderBrush="#555"
                             CornerRadius="4" Padding="8,6" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <CheckBox Content="启用下载历史记录"
                              IsChecked="{Binding EnableDownloadHistory}"
                              Foreground="#CCCCCC" />
                    <CheckBox Content="启用广告过滤"
                              IsChecked="{Binding EnableAdBlock}"
                              Foreground="#CCCCCC" />
                </StackPanel>

                <Button Content="保存" Command="{Binding SaveCommand}"
                        Background="#0078D4" Foreground="White"
                        HorizontalAlignment="Stretch" Padding="0,10"
                        CornerRadius="4" FontSize="15" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
